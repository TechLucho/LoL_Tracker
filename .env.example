# Copia este archivo a .env y rellena los valores. El .env real está gitignoreado.
# El backend valida TODAS estas variables al arrancar: un .env incompleto impide levantar
# el proceso, en vez de degradarse a "no hay datos" a mitad de un request.

# ─── Riot Games ───────────────────────────────────────────────────────────────
# Dev key (RGAPI-...): caduca cada 24h -> https://developer.riotgames.com
# Para no regenerarla a diario, solicita una "Personal API Key".
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_ID=Nombre#TAG
RIOT_REGION=EUW1

# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
# Supabase › Project Settings › Database › Connection string (modo pooler).
# DB_USER debe incluir el project-ref: postgres.<project-ref>
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_NAME=postgres
DB_USER=postgres.tu-project-ref
DB_PASSWORD=
DB_PORT=5432

# ─── App ──────────────────────────────────────────────────────────────────────
# Zona en la que se interpretan las horas del heatmap. Los timestamps se guardan en UTC.
DISPLAY_TIMEZONE=Europe/Madrid

# Si se define, la API exige el header X-API-Token. Vacío = abierta (sólo para uso local).
APP_API_TOKEN=

# Orígenes permitidos por CORS (el dev server de Vite).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Sentry (opcional): si se define, el backend envía errores a Sentry.
# El frontend usa VITE_SENTRY_DSN (en frontend/.env).
SENTRY_DSN=
