# Plantilla para frontend/.env (copiar a .env y rellenar). Vite sólo expone al bundle lo que
# empieza por VITE_ — nunca metas aquí secretos que no deban llegar al navegador.

# URL base de la API en producción (debe incluir /api).
VITE_API_URL=http://localhost:8000/api

# ─── Supabase (auth + JWT) ───────────────────────────────────────────────────
# Dashboard de Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=

# Sentry DSN (opcional): si se define, el frontend envía errores de render y excepciones
# no atrapadas a Sentry.
VITE_SENTRY_DSN=
